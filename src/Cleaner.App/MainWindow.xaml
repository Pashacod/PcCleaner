<ui:FluentWindow x:Class="Cleaner.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:Cleaner.App.Views"
                 Title="PcCleaner (бета)" Icon="Assets/app.png" Width="900" Height="720" MinWidth="640" MinHeight="480"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="PcCleaner (бета) — очистка компьютера" Grid.Row="0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <TabControl Grid.Row="1" Margin="16,4,16,16">
            <TabItem Header="Очистка">
                <views:CleanupView x:Name="Cleanup" />
            </TabItem>
            <TabItem Header="Большие файлы">
                <views:BigFilesView x:Name="BigFiles" />
            </TabItem>
            <TabItem Header="Копии">
                <views:DuplicatesView x:Name="Duplicates" />
            </TabItem>
            <TabItem Header="Программы">
                <views:ProgramsView x:Name="ProgramsTab" />
            </TabItem>
        </TabControl>
        <ui:Button x:Name="SoundButton" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,8,20,0" Padding="8,6" Appearance="Transparent" Click="SoundButton_Click" />
        <!-- Обновление -->
        <Border x:Name="UpdateBar" Grid.Row="2" Margin="16,0,16,16" Padding="16,10" CornerRadius="8"
                Background="#334CAF50" Visibility="{Binding IsVisible, Converter={StaticResource Vis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="Обновить" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}"
                               Command="{Binding InstallCommand}" />
                    <ui:Button Content="Позже" Margin="8,0,0,0" Command="{Binding LaterCommand}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Text}" FontWeight="SemiBold" />
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,6,12,0"
                                 Visibility="{Binding IsDownloading, Converter={StaticResource Vis}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
