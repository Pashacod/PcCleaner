<ui:FluentWindow x:Class="Cleaner.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:Cleaner.App.Views"
                 Title="PcCleaner" Width="900" Height="720" MinWidth="640" MinHeight="480"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="PcCleaner — очистка компьютера" Grid.Row="0" />
        <TabControl Grid.Row="1" Margin="16,4,16,16">
            <TabItem Header="Очистка">
                <views:CleanupView x:Name="Cleanup" />
            </TabItem>
            <TabItem Header="Большие файлы">
                <views:BigFilesView x:Name="BigFiles" />
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
