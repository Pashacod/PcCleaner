<UserControl x:Class="Cleaner.App.Views.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:Card Grid.Row="0" Margin="0,0,0,12">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="Обновить" Icon="{ui:SymbolIcon ArrowSync24}" Margin="8,0,0,0"
                           Command="{Binding RefreshCommand}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,4,0" Opacity="0.8"
                           MaxWidth="360" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                <ui:TextBox PlaceholderText="Поиск по названию или издателю" Icon="{ui:SymbolIcon Search24}"
                            Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </ui:Card>

        <ListBox Grid.Row="1" ItemsSource="{Binding View}" IsEnabled="{Binding IsRemoving, Converter={StaticResource Not}}"
                 VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            <TextBlock Text="{Binding Details}" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="{Binding DateText}" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.7" />
                        <ui:Button Grid.Column="3" Content="Удалить" Icon="{ui:SymbolIcon Delete24}" Margin="12,0,0,0"
                                   Command="{Binding DataContext.UninstallCommand, ElementName=Root}" CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Удаление: ожидание деинсталлятора, затем остатки -->
        <ui:Card Grid.Row="2" Margin="0,12,0,0" Visibility="{Binding IsRemoving, Converter={StaticResource Vis}}">
            <StackPanel>
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="Отмена" Command="{Binding CancelRemoveCommand}"
                               Visibility="{Binding IsWaiting, Converter={StaticResource Vis}}" />
                    <ui:ProgressRing DockPanel.Dock="Left" IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0"
                                     Visibility="{Binding IsWaiting, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding RemoveText}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <StackPanel Visibility="{Binding ShowLeftovers, Converter={StaticResource Vis}}" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding Leftovers}" MaxHeight="200">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" ToolTip="{Binding Path}" />
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Content="Пропустить" Command="{Binding SkipLeftoversCommand}" />
                            <ui:Button Content="Удалить остатки в корзину" Appearance="Primary" Icon="{ui:SymbolIcon Delete24}"
                                       Margin="8,0,0,0" Command="{Binding RemoveLeftoversCommand}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding LeftoverText}" />
                            <TextBlock Text="Папки с именем издателя не отмечены: у него могут быть другие программы" FontSize="12" Opacity="0.6" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </ui:Card>
    </Grid>
</UserControl>
