<UserControl x:Class="Cleaner.App.Views.DuplicatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:Card Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                        <ui:Button Content="Обзор…" Command="{Binding BrowseCommand}" IsEnabled="{Binding IsIdle}" />
                        <ui:Button Content="Найти" Appearance="Primary" Icon="{ui:SymbolIcon Search24}" Margin="8,0,0,0"
                                   Command="{Binding FindCommand}" Padding="20,8" />
                        <ui:Button Content="Отмена" Margin="8,0,0,0" Command="{Binding CancelCommand}"
                                   Visibility="{Binding IsBusy, Converter={StaticResource Vis}}" />
                    </StackPanel>
                    <TextBlock Text="Папка:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ui:TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" />
                </DockPanel>
                <TextBlock Text="{Binding Status}" Margin="0,8,0,0" Opacity="0.8" />
            </StackPanel>
        </ui:Card>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding IsIdle}">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardExpander Margin="0,0,0,6" IsExpanded="False">
                            <ui:CardExpander.Header>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding WastedText}" Margin="12,0" VerticalAlignment="Center" />
                                    <ui:SymbolIcon Symbol="DocumentCopy24" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </ui:CardExpander.Header>
                            <ItemsControl ItemsSource="{Binding Files}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" ToolTip="{Binding Path}" />
                                            <TextBlock Grid.Column="2" Text="{Binding DateText}" Opacity="0.7"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Показать в папке"
                                                       Padding="6,2" HorizontalAlignment="Right"
                                                       Command="{Binding DataContext.OpenFolderCommand, ElementName=Root}"
                                                       CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ui:CardExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ui:Card Grid.Row="2" Margin="0,12,0,0">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="В корзину" Appearance="Primary" Icon="{ui:SymbolIcon Delete24}"
                           Command="{Binding RecycleCommand}" Padding="24,10" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedText}" FontSize="14" />
                    <TextBlock Text="В каждой группе по умолчанию оставлена самая старая копия" FontSize="12" Opacity="0.6" />
                </StackPanel>
            </DockPanel>
        </ui:Card>
    </Grid>
</UserControl>
